# Ayvona Jobs — bot: @ayvona_jobs_bot (admin buyruqlari va ommaviy bot).
#
# ⚠️ .env da BOT_TOKEN bo'sh bo'lsa, bot xabar yozib chiqib ketadi va har 10 soniyada qayta yonib turadi —
#    token qo'yilmaguncha bu servisni YOQMANG.
# ⚠️ Bitta bot tokeni bilan faqat BITTA joyda polling bo'lishi mumkin: server bot ishlayotganda
#    kompyuteringizda xuddi shu tokenli botni ishga tushirmang (TelegramConflictError).
#
# Yoqish:
#   sudo cp /home/ayvona/ayvona/deploy/systemd/ayvona-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ayvona-bot
# Loglar:  journalctl -u ayvona-bot -f
#
# Xotira (1 GB server, 2 GB swap bilan): o'lchangan ~215 MB. Foydalanuvchilar javobini kutadi,
# shuning uchun CPUWeight eng baland.

[Unit]
Description=Ayvona Jobs - Telegram bot (@ayvona_jobs_bot)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ayvona
Group=ayvona
WorkingDirectory=/home/ayvona/ayvona
ExecStart=/home/ayvona/ayvona/.venv/bin/python -m ayvona.apps.bot
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
Nice=0
CPUWeight=200
MemoryHigh=230M
MemoryMax=270M
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
