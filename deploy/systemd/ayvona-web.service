# Ayvona Jobs — web: o'z veb-sayti (FastAPI, faqat o'qish). 127.0.0.1:8080 da tinglaydi,
# tashqariga Caddy (HTTPS) orqali chiqadi: deploy/Caddyfile.example.
#
# IXTIYORIY: 1 GB serverda standart holatda YOQILMAYDI (scripts/server-setup.sh --with-web yoqadi).
# Sayt bazadan faqat o'qiydi — yiqilsa ham collector/worker/bot ishlayveradi.
# Baza eng oxirgi migratsiyada bo'lmasa ishga tushmaydi — avval: alembic upgrade head.
#
# Yoqish:
#   sudo cp /home/ayvona/ayvona/deploy/systemd/ayvona-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ayvona-web
# Loglar:  journalctl -u ayvona-web -f
#
# Xotira: o'lchangan ~95 MB (aiogram va telethon yuklanmaydi).

[Unit]
Description=Ayvona Jobs - web (veb-sayt)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ayvona
Group=ayvona
WorkingDirectory=/home/ayvona/ayvona
ExecStart=/home/ayvona/ayvona/.venv/bin/python -m ayvona.apps.web
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15
Nice=10
CPUWeight=50
MemoryHigh=100M
MemoryMax=130M
OOMScoreAdjust=500
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
