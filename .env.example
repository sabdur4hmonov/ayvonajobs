# =====================================================================
#  Ayvona Jobs — maxfiy sozlamalar
#  1) Bu faylni nusxalang:   Copy-Item .env.example .env
#  2) .env ichidagi qiymatlarni to'ldiring.
#  .env HECH QACHON git'ga qo'shilmaydi (.gitignore da bor).
# =====================================================================

# --- Telegram API (Telethon — kanallarni o'qish uchun) -----------------
# my.telegram.org -> "API development tools" -> App yarating.
# Tavsiya: alohida SIM'dagi ikkinchi Telegram akkaunt bilan.
API_ID=
API_HASH=

# Session fayl yo'li (kengaytmasiz). Login'dan keyin data/ayvona.session paydo bo'ladi.
# Bu fayl = akkauntingizga to'liq kirish. Hech kimga bermang!
TELETHON_SESSION=data/ayvona

# --- Bot API (aiogram — kanalga joylash va ommaviy bot) ----------------
# @BotFather -> /newbot -> tokenni shu yerga qo'ying.
BOT_TOKEN=

# Kanal: @kanal yoki raqamli ID (-100...). AVVAL TEST KANAL qo'ying (bot u yerda admin bo'lsin)!
# Haqiqiy @ayvonajobs ni faqat test kanalda hammasi to'g'ri ishlagach yozing.
# Bo'sh bo'lsa worker kanalga hech narsa yubormaydi (e'lonlar navbatda kutadi).
CHANNEL_ID=

# Adminlar Telegram ID'lari, vergul bilan (o'z ID'ingizni @userinfobot dan bilasiz).
ADMIN_IDS=

# Admin chat (xatolar va backup'lar keladigan yopiq guruh) ID'si, odatda -100... bilan boshlanadi.
ADMIN_CHAT_ID=

# --- Umumiy -------------------------------------------------------------
# Baza fayli (loyiha papkasiga nisbatan).
DB_PATH=data/ayvona.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Foydalanuvchiga ko'rsatiladigan vaqt zonasi (bazada vaqt har doim UTC).
TZ=Asia/Tashkent

# --- Gemini (ixtiyoriy yordamchi, Bosqich 15) -----------------------------
# aistudio.google.com -> "Get API key" (bepul). Bo'sh qolsa hammasi regex bilan ishlaydi.
GEMINI_API_KEY=
# Model (AI Studio'dagi hozirgi bepul modelni tekshiring).
GEMINI_MODEL=gemini-flash-latest
# Qo'shimcha kalitlar (vergul bilan) faqat aylanish yoqilsa ishlatiladi.
# ⚠️ Limitni chetlab o'tish uchun bir necha akkaunt ochish Google shartlariga zid bo'lishi mumkin — standart O'CHIQ.
GEMINI_API_KEYS=
GEMINI_ALLOW_KEY_ROTATION=false
# Bepul tarif himoyasi (ikkalasi ham ixtiyoriy; bo'sh = config/settings.yaml dagi qiymat: 200 so'rov/kun, 4 s oraliq).
# Kunlik so'rovlar chegarasi (Toshkent kuni). Tugagach ertagacha hammasi regex bilan ishlaydi, e'lonlar to'xtamaydi.
GEMINI_DAILY_LIMIT=
# So'rovlar orasidagi eng kam vaqt (soniya). 429 (limit) kelsa kalit dam oladi: 60 -> 120 -> 240 -> ... daqiqa (ko'pi 6 soat).
GEMINI_MIN_INTERVAL_SECONDS=

# --- hh.uz rasmiy API (ixtiyoriy, Bosqich 16) ------------------------------
# dev.hh.ru da ilova ro'yxatdan o'tkazilgach beriladigan application token. Bo'sh = hh.uz manbasi o'chiq.
HH_ACCESS_TOKEN=
# hh talabi: "IlovaNomi/1.0 (sizning@email)" ko'rinishida.
HH_USER_AGENT=

# --- Veb-sayt (ixtiyoriy) -------------------------------------------------
# Saytning ochiq manzili (canonical va sitemap uchun). Serverda scripts/server-setup.sh --with-web buni
# o'zi systemd orqali qo'yadi — bu yerga yozish shart emas. Bo'sh = config/settings.yaml dagi website.base_url.
WEBSITE_BASE_URL=
